# Copia questo file in .env.local e inserisci i valori reali (non committare .env.local)

# Client ID OAuth di Google per il pulsante "Accedi con Google"
VITE_GOOGLE_CLIENT_ID=

# Email autorizzate oltre al dominio @bertifood.it, separate da virgola
# es. VITE_ALLOWED_EMAILS=account.esterno@gmail.com,altro@example.com
VITE_ALLOWED_EMAILS=
